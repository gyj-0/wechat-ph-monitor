page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.value {
  font-size: 72rpx;
  font-weight: 600;
  color: #333;
}

.unit {
  font-size: 32rpx;
  color: #999;
  margin-left: 12rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.status-online {
  color: #07c160;
}

.status-offline {
  color: #fa5151;
}

.btn-group {
  display: flex;
  gap: 24rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  background: #f0f0f0;
  color: #666;
  border: none;
}

.btn::after {
  border: none;
}

.btn-active {
  background: #07c160;
  color: #fff;
}

.btn-danger {
  background: #fa5151;
  color: #fff;
}

.btn-disabled {
  opacity: 0.5;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #666;
}

.info-value {
  color: #333;
  font-weight: 500;
}

.hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  margin-top: 24rpx;
}
