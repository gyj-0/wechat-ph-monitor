.chart {
  width: 100%;
  height: 400rpx;
}

.fold-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fold-title {
  margin-bottom: 0;
}

.fold-arrow {
  color: #999;
  font-size: 24rpx;
}

.btn-plain {
  margin-top: 20rpx;
  background: #f0f0f0;
  color: #07c160;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}

.btn-reset {
  color: #fa5151;
}

.epoch-note {
  color: #ff976a;
  font-size: 24rpx;
}

.empty {
  color: #999;
  font-size: 26rpx;
  text-align: center;
  padding: 32rpx 0;
}
