<view class="container">
  <!-- 连接状态 -->
  <view class="status-bar">
    <text>连接状态</text>
    <text class="{{isConnected ? 'status-online' : 'status-offline'}}">
      {{isConnected ? '已连接' : '未连接'}}
    </text>
  </view>
  <view wx:if="{{!isConnected && statusMsg}}" class="status-bar">
    <text class="status-offline">{{statusMsg}}</text>
  </view>

  <!-- pH 数值显示 -->
  <view class="card">
    <view class="title">实时 pH 值</view>
    <view>
      <text class="value">{{phValue}}</text>
      <text class="unit">pH</text>
    </view>
  </view>

  <!-- pH 过低警告 -->
  <view wx:if="{{phNum !== null && phNum < 6}}" class="alert-banner">
    ⚠ pH 过低（{{phValue}}），请检查水体
  </view>

  <!-- 加液状态 -->
  <view class="card">
    <view class="title">加液状态</view>
    <view class="info-row">
      <text class="info-label">碱泵</text>
      <text class="info-value">{{isAdding ? '运行中' : '已停止'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">更新时间</text>
      <text class="info-value">{{updateTime}}</text>
    </view>
  </view>

  <!-- 模式选择 -->
  <view class="card">
    <view class="title">调节模式</view>
    <view class="btn-group">
      <button
        class="btn {{!isManual ? 'btn-active' : ''}}"
        hover-class="btn-hover"
        data-mode="auto"
        bindtap="onSwitchMode"
      >
        自动调节
      </button>
      <button
        class="btn {{isManual ? 'btn-active' : ''}}"
        hover-class="btn-hover"
        data-mode="manual"
        bindtap="onSwitchMode"
      >
        手动调节
      </button>
    </view>
  </view>

  <!-- 加液控制：仅手动模式 -->
  <view class="card" wx:if="{{isManual}}">
    <button
      class="btn {{autoDosing ? 'btn-danger' : 'btn-active'}}"
      hover-class="btn-hover"
      bindtap="onToggleAdding"
    >
      {{autoDosing ? '停止加液' : '手动加液'}}
    </button>
  </view>

  <view class="hint" wx:if="{{isManual}}">手动模式下设备不自动调节，请注意及时停泵</view>
  <view class="hint" wx:else>自动模式中，设备按 pH 阈值自动调节</view>

  <!-- 数据记录入口 -->
  <view class="card">
    <button
      class="btn"
      hover-class="btn-hover"
      bindtap="onOpenHistory"
    >
      查看数据记录
    </button>
  </view>
</view>
